# Copy to .env (run.py creates it with random seeds on first start). Never commit .env: the seeds ARE the agents' keys.
QU_SEED_CARE=
QU_SEED_MEDS=
QU_SEED_NOTIFY=
QU_HUB_URL=http://localhost:8787
# What the caregiver calls the patient in messages ("Dad"). Defaults to the first name in the health record.
QU_PATIENT_LABEL=
# Which contact in the hub gets caregiver alerts (name as in QU_CONTACTS). Defaults to the first contact.
QU_CAREGIVER_NAME=
# 1 = do not connect the Care agent to the Agentverse mailbox (local testing only)
QU_LOCAL_ONLY=0
